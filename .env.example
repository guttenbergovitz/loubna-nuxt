# SMTP Configuration for Nodemailer
# Copy this file to .env and fill in your actual SMTP credentials

# SMTP server hostname (e.g., smtp.gmail.com, mail.example.com)
SMTP_HOST=your-smtp-host.com

# SMTP server port (common ports: 587 for TLS, 465 for SSL, 25 for unencrypted)
SMTP_PORT=465

# Use secure connection (true for SSL/TLS on port 465, false for STARTTLS on port 587)
SMTP_SECURE=true

# SMTP authentication username (usually your email address)
SMTP_USER=your-email@example.com

# SMTP authentication password (use app-specific password if using Gmail/OAuth)
SMTP_PASS=your-smtp-password

# Email address that will appear as the sender (From field)
SMTP_FROM=noreply@example.com

# Email recipient for contact form notifications (owner's email)
OWNER_EMAIL=owner@example.com

# ─────────────────────────────────────────────────────────────
# Nuxt Studio (content editing) — PRODUCTION setup
# Docs: https://nuxt.studio
#
# Enabling Studio in production requires a GitHub OAuth App.
# 1. Create one: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#    - Homepage URL: https://loubnaphoto.no
#    - Authorization callback URL: https://loubnaphoto.no/__nuxt_studio/auth/github
# 2. Copy the Client ID / Client Secret below into your hosting provider's env vars
#    (Vercel → Project → Settings → Environment Variables).
# 3. Log in to the editor at https://loubnaphoto.no/_studio
# -------------------------------------------------------------

# GitHub OAuth Client ID (detected in prod ONLY from env — required for login)
STUDIO_GITHUB_CLIENT_ID=your-github-oauth-client-id

# GitHub OAuth Client Secret (required for login)
STUDIO_GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Optional: comma-separated GitHub account emails allowed to log in (recommended —
# limits editor access to your own account). Example: loubna@example.com
# STUDIO_GITHUB_MODERATORS=loubna@example.com

# Optional: GitHub Personal Access Token (classic, repo scope) used instead of the
# OAuth token for git pushes. Not required for a public repo with OAuth login.
# STUDIO_GITHUB_TOKEN=ghp_xxx
